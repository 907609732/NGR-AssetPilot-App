{
  "name": "ngr-assetpilot-desktop",
  "version": "3.0.6",
  "private": true,
  "description": "NGR AssetPilot Windows desktop application",
  "license": "MIT",
  "author": "五成（月财）",
  "type": "module",
  "main": "desktop/main/index.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron .",
    "dev:test": "electron . --ngr-edition=test",
    "env:check": "node scripts/check-environment.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:packaging": "node --test tests/packaging-infrastructure.test.mjs",
    "test:local-image-search:performance": "node scripts/benchmark-local-image-search.mjs",
    "test:local-image-search:index": "node scripts/benchmark-local-image-index.mjs",
    "build:prod": "node scripts/run-build.mjs prod",
    "build:dev": "node scripts/run-build.mjs dev",
    "build:test": "node scripts/run-build.mjs test",
    "build": "npm run build:prod",
    "build:all": "npm run build:prod && npm run build:dev && npm run build:test",
    "release:metadata:prod": "node scripts/generate-release-metadata.mjs prod",
    "release:metadata:dev": "node scripts/generate-release-metadata.mjs dev",
    "release:metadata:test": "node scripts/generate-release-metadata.mjs test",
    "release:scan:prod": "node scripts/scan-package-secrets.mjs prod",
    "release:scan:dev": "node scripts/scan-package-secrets.mjs dev",
    "release:scan:test": "node scripts/scan-package-secrets.mjs test",
    "verify:packaged:prod": "node scripts/verify-packaged-apps.mjs prod"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "adm-zip": "0.6.0",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "onnxruntime-node": "1.24.3",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "sharp": "0.35.3",
    "adm-zip": "0.6.0"
  }
}
